# ================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - FRONTEND
# ================================================================
# Copia este archivo como .env y ajusta los valores.
#
# DESARROLLO LOCAL: apunta a tu backend local (localhost:4024)
# PRODUCCION (Railway): las variables se configuran en el
#   dashboard de Railway con la URL del backend desplegado.
# ================================================================

# --- URL del backend ---
# LOCAL:      http://localhost:4024/api
# RAILWAY:    https://TU-BACKEND.up.railway.app/api (se configura en el dashboard)
VITE_API_URL=http://localhost:4024/api
VITE_SOCKET_URL=http://localhost:4024

# --- URL pública canónica del frontend ---
# Se usa para construir links compartibles (ej. link de referido).
# En el APK (Capacitor), window.location.origin es "https://localhost" — esta
# variable garantiza que los links apunten siempre al dominio público real.
# PRODUCCIÓN: https://aloganagas.com.pe
VITE_PUBLIC_WEB_URL=https://aloganagas.com.pe
