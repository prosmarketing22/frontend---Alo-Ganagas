# ============================================================
# Variables de entorno para el build del APK Cliente
# Vite las inyecta en compile-time al ejecutar vite build --mode cliente
# ============================================================

# Backend público en VPS OVH (cert Let's Encrypt válido)
VITE_API_URL=https://aloganagas.com.pe/api
VITE_SOCKET_URL=https://aloganagas.com.pe

# URL pública canónica del frontend (para generar links compartibles, ej. referidos)
# En el APK, window.location.origin es "https://localhost" — esta variable evita ese problema.
VITE_PUBLIC_WEB_URL=https://aloganagas.com.pe
