{
  "name": "alo-ganagas-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npx serve dist -s -l $PORT",
    "build:cliente": "vite build --config vite.config.cliente.js --mode cliente && node scripts/rename-index-cliente.js",
    "cap:sync": "npm run build:cliente && cap sync android",
    "cap:open": "cap open android",
    "cap:run": "npm run build:cliente && cap run android",
    "cap:build:apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "test": "jest --config jest.config.js",
    "test:components": "jest --config jest.config.js __tests__/components --verbose",
    "test:hooks": "jest --config jest.config.js __tests__/hooks --verbose",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report __tests__/reports/playwright"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/push-notifications": "^8.1.1",
    "date-fns": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.6.0",
    "socket.io-client": "^4.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "babel-jest": "^30.2.0",
    "detect-port": "^2.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.4.0",
    "vite": "^5.0.8",
    "wait-on": "^9.0.3"
  }
}
